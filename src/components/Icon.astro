---
interface Props { name: 'download' | 'store' | 'play' | 'plus' | 'arrow' | 'enlarge'; size?: number }
const { name, size = 18 } = Astro.props;
const paths = {
  download: 'M12 3v12m-5-5 5 5 5-5M4 16v4h16v-4',
  store: 'm10 3 9 16M14 3 5 19M3 15h12m3 0h3',
  play: 'M7 4.5 19 12 7 19.5z',
  plus: 'M5 12h14m-7-7v14',
  arrow: 'M3 12h17m-7-7 7 7-7 7',
  enlarge: 'M14 4h6v6m0-6-7 7M10 20H4v-6m0 6 7-7',
};
const solid = name === 'play';
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill={solid ? 'currentColor' : 'none'} stroke={solid ? 'none' : 'currentColor'} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  <path d={paths[name]} />
</svg>
